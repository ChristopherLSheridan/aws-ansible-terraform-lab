{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EC2ReadOnlyDiscovery",
            "Effect": "Allow",
            "Action": "ec2:Describe*",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": "us-east-2"
                }
            }
        }
    ]
}
