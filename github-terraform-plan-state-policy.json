{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::terraform-gitops-state-844274145888"
    },
    {
      "Sid": "ReadTerraformState",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::terraform-gitops-state-844274145888/terraform.tfstate"
    },
    {
      "Sid": "ManageStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::terraform-gitops-state-844274145888/terraform.tfstate.tflock"
    }
  ]
}
